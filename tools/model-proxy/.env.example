PORT=8787
MODEL_PROVIDER=tencentcloud
TENCENTCLOUD_SECRET_ID=replace-with-your-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-your-secret-key
TENCENT_HUNYUAN_ENDPOINT=https://hunyuan.tencentcloudapi.com
TENCENTCLOUD_REGION=
MODEL_NAME=hunyuan-vision
TENCENT_MAP_KEY=replace-with-your-tencent-map-key
TENCENT_MAP_SK=replace-with-your-tencent-map-sk-if-sn-check-is-enabled
TENCENT_MAP_NETWORK_URL=https://apis.map.qq.com/ws/location/v1/network

# Alternative: use the OpenAI-compatible Hunyuan endpoint with an sk-* API key.
# MODEL_PROVIDER=openai-compatible
MODEL_API_KEY=replace-with-your-key
MODEL_API_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
MODEL_JSON_MODE=false
