page {
  background: #f3f6f7;
}

.map-page {
  padding-bottom: 40rpx;
}

.map-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.map-title {
  display: block;
  color: #111827;
  font-size: 40rpx;
  font-weight: 800;
}

.map-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.refresh-button {
  flex: 0 0 auto;
  width: auto;
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #0f766e;
  background: #e7f5f2;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 64rpx;
}

.campus-map {
  width: 100%;
  height: 660rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.legend {
  display: flex;
  gap: 24rpx;
  margin: 16rpx 0 20rpx;
  color: #667085;
  font-size: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  background: #98a2b3;
  border-radius: 50%;
}

.legend-dot.active {
  background: #0f766e;
}

.location-panel {
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(16, 24, 40, 0.06);
  border-radius: 8rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.05);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.panel-title {
  display: block;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.panel-meta {
  display: block;
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
}

.small {
  padding: 30rpx 0;
}

.location-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef2f5;
}

.item-title {
  display: block;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.item-meta {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.item-pill {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  color: #ffffff;
  background: #0f766e;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}
